# Optional private configuration. Copy to .env, which is excluded from Git.
# Credentials are also read from ../tools/.env, like the Golf app.
# OPENAI_ENV_FILE=/absolute/path/to/shared/.env
# OPENAI_API_KEY=your-private-key
# OPENAI_PROJECT=your-project-id
# OPENAI_ORG_ID=your-organization-id
HOUSE_OPENAI_MODEL=gpt-6-astra
